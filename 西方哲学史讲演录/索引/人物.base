filters:
  and:
    - file.inFolder("西方哲学史讲演录/人物")
    - file.ext == "md"
properties:
  school:
    displayName: 学派
  flourished:
    displayName: 鼎盛年约
views:
  - type: table
    name: 按学派
    groupBy:
      property: school
      direction: ASC
    order:
      - file.name
      - school
      - flourished
  - type: cards
    name: 卡片
    order:
      - file.name
      - school
